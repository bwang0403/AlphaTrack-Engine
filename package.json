{
  "name": "alphatrack-engine",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --local",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "cf:typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply alphatrack-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply alphatrack-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:browser": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^22.20.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "^4.151.0"
  }
}
